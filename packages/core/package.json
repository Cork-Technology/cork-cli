{
  "name": "@cork/core",
  "version": "0.4.1-rc.1",
  "description": "Cork helper core: math ports, chain reads, Bundler3 encode/decode, and the runTool dispatch.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/packages/core/src/index.js",
  "types": "./dist/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js",
      "default": "./dist/packages/core/src/index.js"
    },
    "./bundle": {
      "types": "./dist/packages/core/src/exports/bundle.d.ts",
      "import": "./dist/packages/core/src/exports/bundle.js",
      "default": "./dist/packages/core/src/exports/bundle.js"
    },
    "./chain": {
      "types": "./dist/packages/core/src/exports/chain.d.ts",
      "import": "./dist/packages/core/src/exports/chain.js",
      "default": "./dist/packages/core/src/exports/chain.js"
    },
    "./config": {
      "types": "./dist/packages/core/src/exports/config.d.ts",
      "import": "./dist/packages/core/src/exports/config.js",
      "default": "./dist/packages/core/src/exports/config.js"
    },
    "./indexer": {
      "types": "./dist/packages/core/src/exports/indexer.d.ts",
      "import": "./dist/packages/core/src/exports/indexer.js",
      "default": "./dist/packages/core/src/exports/indexer.js"
    },
    "./math": {
      "types": "./dist/packages/core/src/exports/math.d.ts",
      "import": "./dist/packages/core/src/exports/math.js",
      "default": "./dist/packages/core/src/exports/math.js"
    },
    "./orders": {
      "types": "./dist/packages/core/src/exports/orders.d.ts",
      "import": "./dist/packages/core/src/exports/orders.js",
      "default": "./dist/packages/core/src/exports/orders.js"
    },
    "./registry": {
      "types": "./dist/packages/core/src/exports/registry.d.ts",
      "import": "./dist/packages/core/src/exports/registry.js",
      "default": "./dist/packages/core/src/exports/registry.js"
    },
    "./venue": {
      "types": "./dist/packages/core/src/exports/venue.d.ts",
      "import": "./dist/packages/core/src/exports/venue.js",
      "default": "./dist/packages/core/src/exports/venue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cork-Technology/cork-helper-cli.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@cork/schemas": "workspace:*",
    "viem": "2.55.2",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@envio-dev/hypersync-client": "1.4.0",
    "@envio-dev/hypersync-client-darwin-arm64": "1.4.0",
    "@envio-dev/hypersync-client-darwin-x64": "1.4.0",
    "@envio-dev/hypersync-client-linux-arm64-gnu": "1.4.0",
    "@envio-dev/hypersync-client-linux-x64-gnu": "1.4.0",
    "@envio-dev/hypersync-client-linux-x64-musl": "1.4.0"
  }
}
