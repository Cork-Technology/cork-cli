{
  "name": "cork-helper-cli",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/{fork-parity,bundle-sim,rpc-live,hyperrpc-live}.test.ts'",
    "test:live": "vitest run packages/core/test/fork-parity.test.ts packages/core/test/bundle-sim.test.ts packages/core/test/rpc-live.test.ts packages/core/test/hyperrpc-live.test.ts",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='packages/*/src/**' --coverage.exclude='**/bin.ts' --coverage.exclude='**/types.ts' --coverage.reporter=text --coverage.reporter=html --exclude '**/{fork-parity,bundle-sim,rpc-live,hyperrpc-live}.test.ts'",
    "test:mutation": "bun scripts/mutation-probes.ts",
    "test:prop": "test -f experiments/proptest/core.proptest.ts && test -f experiments/proptest/fusion.proptest.ts && bun test ./experiments/proptest/core.proptest.ts ./experiments/proptest/fusion.proptest.ts",
    "build": "node scripts/build-packages.mjs",
    "verify:package": "node scripts/verify-package-layout.mjs",
    "eval": "bun evals/run.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "12.1.0",
    "viem": "2.55.2",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@envio-dev/hypersync-client": "1.4.0"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
