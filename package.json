{
  "name": "cork-helper-cli",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/{fork-parity,bundle-sim,rpc-live}.test.ts'",
    "test:live": "vitest run packages/core/test/fork-parity.test.ts packages/core/test/bundle-sim.test.ts packages/core/test/rpc-live.test.ts",
    "build": "node scripts/build-packages.mjs",
    "verify:package": "node scripts/verify-package-layout.mjs",
    "eval": "bun evals/run.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2",
    "ajv": "^8.17.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "viem": "^2.21.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@envio-dev/hypersync-client": "^1.4.0"
  }
}
